module bluetooth_adapter@1.0

callback OnDevicePaired(boolean result, object device, string message);
callback OnTimeout();

promise<void> startDiscovery();
promise<void> stopDiscovery();
promise<void> setDiscoveryFilter(object dict_value);
promise<string[]> getDiscoveryFilters();
promise<object> connectDevice(object properties);
promise<void> removeDevice(string device_path);
promise<string[]> getBondedDevice();

promise<object> getDevices();
object getPairedDevices();
object getConnectedDevices();
// callback boolean filter_cb(device)
object getDevicesFilter(object filter_cb);

// pair ble device
// boolean filter_cb(object device)
// this function shall not be called in formal code. It's only for test.
void tryPairBLEDevices(object filter_cb, OnDevicePaired paired_cb, OnTimeout timeout_cb, int timeout_ms);

event opened();
event deviceAdded(object device);
event deviceRemoved(object device);
event propertiesChanged(object props);
event deviceisConnected(object props);



property boolean isOpened readonly;
property string Path readonly;
property string Address readonly;
property string AddressType readonly;
property string Name readonly;
property uint Class readonly;  // 0 classic-bt, 1 ble
property string Alias;
property boolean Powered;
property boolean Discoverable;
property boolean Pairable;
property int PairableTimeout;
property int DiscoverableTimeout;
property int Discovering readonly;
property string[] UUIDs readonly;

/*
 * device interfaces
 */
interface device {
  promise<void> connect();
  promise<void> disconnect();
  promise<void> connectProfile(string uuid);
  promise<void> disconnectProfile(string uuid);
  promise<void> pair();
  promise<void> cancelPairing();

  property string address readonly;
  property string addressType readonly;
  property string name readonly;
  property string icon readonly;
  property string clazz readonly;
  property int appearance readonly;
  property string[] UUIDs readonly;
  property boolean paired readonly;
  property boolean connected readonly;
  property boolean trusted;
  property boolean blocked;
  property string alias;
  property boolean legacyPairing readonly;
  property string modalias readonly;
  property int RSSI readonly;
  property int txPower readonly;
  property object manufactureData readonly;
  property object serviceData readonly;
  property boolean servicesResolved readonly;
  property object advertisingFlags readonly;
}
