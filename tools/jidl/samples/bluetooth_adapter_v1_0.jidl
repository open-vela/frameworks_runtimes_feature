module bluetooth_adapter@1.0

callback OnDevicePaired(boolean result, jsvalue device, string message);
callback OnTimeout();

promise<void, string> startDiscovery();
promise<void, string> stopDiscovery();
promise<void, string> setDiscoveryFilter(jsvalue dict_value);
promise<string[], string> getDiscoveryFilters();
promise<jsvalue, string> connectDevice(jsvalue properties);
promise<void, string> removeDevice(string device_path);
promise<string[], string> getBondedDevice();

promise<jsvalue, string> getDevices();
jsvalue getPairedDevices();
jsvalue getConnectedDevices();
// callback boolean filter_cb(device)
jsvalue getDevicesFilter(jsvalue filter_cb);

// pair ble device
// boolean filter_cb(jsvalue device)
// this function shall not be called in formal code. It's only for test.
void tryPairBLEDevices(jsvalue filter_cb, OnDevicePaired paired_cb, OnTimeout timeout_cb, int timeout_ms);

event opened();
event deviceAdded(jsvalue device);
event deviceRemoved(jsvalue device);
event propertiesChanged(jsvalue props);
event deviceisConnected(jsvalue props);



property boolean isOpened readonly;
property string Path readonly;
property string Address readonly;
property string AddressType readonly;
property string Name readonly;
property uint Class readonly;  // 0 classic-bt, 1 ble
property string Alias;
property boolean Powered;
property boolean Discoverable;
property boolean Pairable;
property int PairableTimeout;
property int DiscoverableTimeout;
property int Discovering readonly;
property string[] UUIDs readonly;

/*
 * device interfaces
 */
interface device {
  promise<void, string> connect();
  promise<void, string> disconnect();
  promise<void, string> connectProfile(string uuid);
  promise<void, string> disconnectProfile(string uuid);
  promise<void, string> pair();
  promise<void, string> cancelPairing();

  property string address readonly;
  property string addressType readonly;
  property string name readonly;
  property string icon readonly;
  property string clazz readonly;
  property int appearance readonly;
  property string[] UUIDs readonly;
  property boolean paired readonly;
  property boolean connected readonly;
  property boolean trusted;
  property boolean blocked;
  property string alias;
  property boolean legacyPairing readonly;
  property string modalias readonly;
  property int RSSI readonly;
  property int txPower readonly;
  property jsvalue manufactureData readonly;
  property jsvalue serviceData readonly;
  property boolean servicesResolved readonly;
  property jsvalue advertisingFlags readonly;
}
