module wifi@1.0

callback on_data(object data);
callback on_fail(string data, int code);
callback on_void();


struct CommonParam {
  callback on_data success;
  callback on_fail fail;
  callback on_void complete;
};

[
  json_method = "wifi.getwifilist",
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__JSONDATA",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_JSONARG",
  msg_sub_type = "Jsonmsg"
]
void getWifiList(CommonParam p);


[
  json_method = "wifi.getconnectedwifi",
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__JSONDATA",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_JSONARG",
  msg_sub_type = "Jsonmsg"
]
void getConnectedWifi(CommonParam p);

[
  json_method = "wifi.scan",
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__JSONDATA",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_JSONARG",
  msg_sub_type = "Jsonmsg"
]
void scan(CommonParam p);

struct WifiConnectParam {
  string SSID;
  string BSSID;
  string password;
  on_data success;
  on_fail fail;
  on_void complete;
}

[
  json_method = "wifi.connect",
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__JSONDATA",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_JSONARG",
  msg_sub_type = "Jsonmsg"
]
void connect(WifiConnectParam p);

struct WifiDisconnectParam {
  string SSID;
  string security;
  on_data success;
  on_fail fail;
  on_void complete;
}

[
  json_method = "wifi.disconnect",
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__JSONDATA",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_JSONARG",
  msg_sub_type = "Jsonmsg"
]
void disconnect(WifiDisconnectParam p);

[
  json_method = "wifi.remove",
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__JSONDATA",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_JSONARG",
  msg_sub_type = "Jsonmsg"
]
void remove(WifiDisconnectParam p);

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__MIOTSETNOTIFY",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_OTSUBARG",
  msg_sub_type = "Otsubmsg"
]
property on_data onscanned writeonly

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__MIOTSETNOTIFY",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_OTSUBARG",
  msg_sub_type = "Otsubmsg"
]
property on_data onstatechanged writeonly
