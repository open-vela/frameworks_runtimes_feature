module settings@1.0

callback on_void();
callback on_fail(string data, int code);
callback on_data(object data);

struct CommonParam {
  on_data success;
  on_fail fail;
  on_void complete;
};

struct FactoryResetParam {
  [msg_key = "wipe", to_msg = "bool"]
  boolean wipe;
  on_void success;
  on_fail fail;
  on_void complete;
};

[
  json_method = "factoryreset",
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__JSONDATA",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_JSONARG",
  msg_sub_type = "Jsonmsg"
]
void factoryReset(FactoryResetParam p);

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__SETTINGDEVTOKEN",
  msg_arg_id = "MIOTMSG__TEST_ONEOF__NOT_SET"
]
void getDeviceToken(CommonParam p);

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__SETTINGGETMIIODID"
]
void getMiioDid(CommonParam p);

struct SetSleepModeParams {
  string sleep_mode;
  string total;
  string start;
  string stop;
  [msg_key = "night_volume", to_msg = "int"]
  int night_volume;
  on_data success;
  on_fail fail;
  on_void complete;
}

[
  json_method = "setting.setsleepmode",
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__JSONDATA",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_JSONARG",
  msg_sub_type = "Jsonmsg"
]
void setSleepMode(SetSleepModeParams p);

[
  json_method = "setting.getsleepmodestatus",
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__JSONDATA",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_JSONARG",
  msg_sub_type = "Jsonmsg"
]
void getSleepModeStatus(CommonParam p);
