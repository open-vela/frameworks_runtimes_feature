module audiofocus@1.0

callback on_void();
callback on_fail(string data, int code);


[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__AUDIOFOCUSNOTIFY",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_AUDIOFOCUSSUBARG",
  msg_sub_type = "Audiofocussubmsg"
]
property on_void onfocusstate writeonly;

struct FocusParam {
  [msg_key = "functype"]
  int focusType;
  callback on_void success;
  callback on_fail fail;
  callback on_void complete;
};

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__AUDIOFOCUSREQUEST",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_AUDIOFOCUSREQUESTARG",
  msg_sub_type = "Audiofocusrequestmsg"
]
void requestFocus(FocusParam p);

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__AUDIOFOCUSABANDON",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_AUDIOFOCUSABANDONARG",
  msg_sub_type = "Audiofocusrequestmsg"
]
void abandonFocus(FocusParam p);
