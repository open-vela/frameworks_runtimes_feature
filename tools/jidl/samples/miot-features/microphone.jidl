module microphone@1.0

callback on_void();
callback on_fail(string data, int code);
callback on_data(object data);

struct GetStateParam {
  on_void success;
  on_fail fail;
  on_void complete;
};

struct SetStateParam {
  boolean state;
  on_void success;
  on_fail fail;
  on_void complete;
};

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__MICGETSTATE",
  msg_arg_id = "MIOTMSG__TEST_ONEOF__NOT_SET"
]
void getState(GetStateParam p);

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__MICSETSTATE",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_MICSETSTATEARG",
  msg_sub_type = "Micsetstatemsg"
]
void setState(SetStateParam p);

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__MICNOTIFY",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_MICSUBARG",
  msg_sub_type = "Micsubmsg"
]
property on_data onstatechange writeonly;
