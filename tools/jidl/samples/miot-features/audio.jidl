struct AudioPlayParam {
  string audioId;
  string type;
  [msg_key = "payload", to_msg = "(char*)ft_to_string"]
  object payload;
  on_data success;
  on_fail fail;
  on_void complete;
};

[
  json_method = "audio.play",
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__JSONDATA",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_JSONARG",
  msg_sub_type = "Jsonmsg"
]
void play(AudioPlayParam p);

struct AudioPauseParam {
  string audioId;
  string type;
  on_data success;
  on_fail fail;
  on_void complete;
}

[
  json_method = "audio.pause",
