module chime@1.0

callback on_data(object data);
callback on_fail(string data, int code);
callback on_void();


struct CommonParam {
  callback on_data success;
  callback on_fail fail;
  callback on_void complete;
}

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__MIOTSETNOTIFY",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_OTSUBARG",
  msg_sub_type = "Otsubmsg"
]
property on_data onchimehourlybell writeonly

[
  json_method = "chime.getchimehourly",
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__JSONDATA",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_JSONARG",
  msg_sub_type = "Jsonmsg"
]
void getChimeHourly(CommonParam p);

struct SetChimeHourlyParam {
  string status;
  [msg_key = "chime_hourly", to_msg = "(char*)ft_to_string"]
  object chime_hourly;
  on_data success;
  on_fail fail;
  on_void complete;
}

[
  json_method = "chime.setchimehourly",
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__JSONDATA",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_JSONARG",
