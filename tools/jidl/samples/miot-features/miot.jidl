module miot@1.0; // bootstrap

callback on_void();
callback on_fail(string data, int code);
callback on_data(object data);

struct CommonParam {
  on_data success;
  on_fail fail;
  on_void complete;
};

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__BINDSTATE",
  msg_arg_id = "MIOTMSG__TEST_ONEOF__NOT_SET"
]
void getBindState(CommonParam p);

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__MIOTSETNOTIFY",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_OTSUBARG",
  msg_sub_type = "Otsubmsg"
]
property on_data onstartnetworkconnect writeonly;

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__MIOTSETNOTIFY",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_OTSUBARG",
  msg_sub_type = "Otsubmsg"
]
property on_data onnetworkconnectstate writeonly;

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__MIOTSETNOTIFY",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_OTSUBARG",
  msg_sub_type = "Otsubmsg"
]
property on_data onloginpara writeonly;

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__MIOTSETNOTIFY",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_OTSUBARG",
  msg_sub_type = "Otsubmsg"
]
property on_data onbinddevicestate writeonly;

struct SetLoginStateParam {
  [ msg_key = "state" ]
  boolean loginState;
  on_data success;
  on_fail fail;
  on_void complete;
};

[
  msg_sub_id = "MIOTMSG__MSGSUBTYPE__SETLOGINSTATE",
  msg_arg_id = "MIOTMSG__TEST_ONEOF_LOGINARG",
  msg_sub_type = "Loginmsg"
]
void setLoginState(SetLoginStateParam p);
