    [value="LV_CHART_AXIS_PRIMARY_Y"]
    PRIMARY_Y,
    [value="LV_CHART_AXIS_SECONDARY_Y"]
    SECONDARY_Y,
    [value="LV_CHART_AXIS_PRIMARY_X"]
    PRIMARY_X,
    [value="LV_CHART_AXIS_SECONDARY_X"]
    SECONDARY_X
  }

  enum DrawPart {
    [value="LV_CHART_DRAW_PART_DIV_LINE_INIT"]
    DIV_LINE_INIT,
    [value="LV_CHART_DRAW_PART_DIV_LINE_HOR"]
    DIV_LINE_HOR,
    [value="LV_CHART_DRAW_PART_DIV_LINE_VER"]
    DIV_LINE_VER,
    [value="LV_CHART_DRAW_PART_LINE_AND_POINT"]
    LINE_AND_POINT,
    [value="LV_CHART_DRAW_PART_BAR"]
    BAR,
    [value="LV_CHART_DRAW_PART_CURSOR"]
    CURSOR,
    [value="LV_CHART_DRAW_PART_TICK_LABEL"]
    TICK_LABEL
  }

  [set="lv_chart_set_type", get="lv_chart_get_type"]
