module lv_binding@1.0;

enum Align {
  [value="LV_ALIGN_TOP_LEFT"]
  TOP_LEFT,
  [value="LV_ALIGN_TOP_MID"]
  TOP_MID,
  [value="LV_ALIGN_TOP_RIGHT"]
  TOP_RIGHT,
  [value="LV_ALIGN_BOTTOM_LEFT"]
  BOTTOM_LEFT,
  [value="LV_ALIGN_BOTTOM_MID"]
  BOTTOM_MID,
  [value="LV_ALIGN_BOTTOM_RIGHT"]
  BOTTOM_RIGHT,
  [value="LV_ALIGN_LEFT_MID"]
  LEFT_MID,
  [value="LV_ALIGN_RIGHT_MID"]
  RIGHT_MID,
  [value="LV_ALIGN_CENTER"]
  CENTER,

  [value="LV_ALIGN_OUT_TOP_LEFT"]
  OUT_TOP_LEFT,
  [value="LV_ALIGN_OUT_TOP_MID"]
  OUT_TOP_MID,
  [value="LV_ALIGN_OUT_TOP_RIGHT"]
  OUT_TOP_RIGHT,
  [value="LV_ALIGN_OUT_BOTTOM_LEFT"]
  OUT_BOTTOM_LEFT,
  [value="LV_ALIGN_OUT_BOTTOM_MID"]
  OUT_BOTTOM_MID,
  [value="LV_ALIGN_OUT_BOTTOM_RIGHT"]
  OUT_BOTTOM_RIGHT,
  [value="LV_ALIGN_OUT_LEFT_TOP"]
  OUT_LEFT_MID,
  [value="LV_ALIGN_OUT_LEFT_MID"]
  OUT_LEFT_MID,
  [value="LV_ALIGN_OUT_LEFT_BOTTOM"]
  OUT_LEFT_MID,
  [value="LV_ALIGN_OUT_RIGHT_TOP"]
  OUT_RIGHT_MID,
  [value="LV_ALIGN_OUT_RIGHT_MID"]
  OUT_RIGHT_MID,
  [value="LV_ALIGN_OUT_RIGHT_BOTTOM"]
  OUT_RIGHT_MID,
};

[from_native="from_widget_event", to_native="to_widget_event"]
interface WidgetEvent {
  [get="lv_event_get_code"]
  property int code readonly;

  [get="lv_event_get_target"]
  property Widget target readonly;

  [get="lv_event_get_current_target"]
  property Widget current_target readonly;

  [get="lv_event_get_param"]
  property Widget paramWidget readonly;

  [get="lv_event_get_param"]
  property string paramString readonly;

  [get="lv_event_get_param"]
  property int paramInt readonly;

  [get="lv_event_get_user_data"]
  property Widget userWidget readonly;

  [get="lv_event_get_user_data"]
  property int userInt readonly;

  [get="lv_event_get_user_data"]
  property string userString readonly;
};

callback event_cb(WidgetEvent evt);

[from_native="from_widget", to_native="to_widget", native_type="lv_obj_t*", finalizer="finalize_widget", need_parent=true]
interface Widget {
  [set="lv_obj_set_id", get="lv_obj_get_id"]
  property string id readonly;

  [set="lv_obj_set_x", get="lv_obj_get_x"]
  property int x;
  [set="lv_obj_set_y", get="lv_obj_get_y"]
  property int y;
  [set="lv_obj_set_width", get="lv_obj_get_width"]
  property int width;
  [set="lv_obj_set_height", get="lv_obj_get_height"]
  property int height;
  [set="lv_obj_set_content_width", get="lv_obj_get_content_width"]
  property int contentWidth;
  [set="lv_obj_set_content_height", get="lv_obj_get_content_height"]
  property int contentHeight;

  [set="lv_obj_set_align"]
  property Align align writeonly;

  [func="lv_obj_set_pos"]
  void setPos(int x, int y);
  [func="lv_obj_set_size"]
  void setSize(int width, int height);
  [func="lv_obj_set_layout"]
  void setLayout(int layout);
}

const LV_LABEL_LONG_WRAP = 0;
const LV_LABEL_LONG_DOT = 1;
const LV_LABEL_LONG_SCROLL = 2;
const LV_LABEL_LONG_SCROLL_CIRCULAR = 3;
const LV_LABEL_LONG_CLIP = 4;

[tag="label", create="lv_label_create"]
interface Label extends Widget {
  [set="lv_label_set_text", get="lv_label_get_text"]
  property string text;
  [set="lv_label_set_long_mode", get="lv_label_get_long_mode"]
  property int longMode;
  [set="lv_label_set_recolor", get="lv_label_get_recolor"]
  property boolean recolor;
}

[tag="button", create="lv_btn_create"]
interface Button extends Widget {
  [type="event", source_gen="event-call", code="LV_EVENT_CLICKED", event_type="WidgetEvent"]
  property event_cb onclick writeonly;
}

boolean inflate(object param);

Widget findWidget(string id);
