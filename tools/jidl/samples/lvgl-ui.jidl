boolean inflate(object parent, object param);

Widget findWidget(string id);

[get="lvgl_get_root", once=true]
property Widget root readonly;

///////////////////////////////////////////////////
// math
[func="lv_trigo_sin", need_self=false]
int trigoSin(int v);
[func="lv_trigo_cos", need_self=false]
int trigoCos(int v);
[func="lv_bezier3", need_self=false]
int bezier3(uint t, uint u0, uint u1, uint u2, uint u3);
[func="lv_atan2", need_self=false]
int atan2(int x, int y);
[func="lv_pow", need_self=false]
long pow(long base, int exp);
[func="lv_map", need_self=false]
int map(int x, int min_in, int max_in, int min_out, int max_out);

