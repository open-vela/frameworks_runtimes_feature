  [set="lv_style_set_outline_width"]
  property int outlineWidth writeonly;
  [set="lv_style_set_outline_color"]
  property lv_color_t outlineColor writeonly;
  [set="lv_style_set_outline_opa"]
  property int outlineOPA writeonly;
  [set="lv_style_set_outline_pad"]
  property int outlinePad writeonly;
  [set="lv_style_set_shadow_width"]
  property int shadowWidth writeonly;
  [set="lv_style_set_shadow_ofs_x"]
  property int shadowOFSX writeonly;
  [set="lv_style_set_shadow_ofs_y"]
