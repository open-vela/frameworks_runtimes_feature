[
  tag="chart",
  create="lv_chart_create",
  native_class="lv_chart_class"
]
interface Chart extends Widget {
 enum Type {
   [value="LV_CHART_TYPE_NONE"]
   NONE,
   [value="LV_CHART_TYPE_LINE"]
   LINE,
   [value="LV_CHART_TYPE_BAR"]
   BAR,
   [value="LV_CHART_TYPE_SCATTER"]
   SCATTER
 }

  enum UpdateMode {
    [value="LV_CHART_UPDATE_MODE_SHIFT"]
    SHIFT,
    [value="LV_CHART_UPDATE_MODE_CIRCULAR"]
    CIRCULAR
  }

