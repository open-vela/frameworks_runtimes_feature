const LV_LABEL_LONG_WRAP = 0;
const LV_LABEL_LONG_DOT = 1;
const LV_LABEL_LONG_SCROLL = 2;
const LV_LABEL_LONG_SCROLL_CIRCULAR = 3;
const LV_LABEL_LONG_CLIP = 4;

[tag="label", create="lv_label_create", native_class="lv_label_class"]
interface Label extends Widget {
  [set="lv_label_set_text", get="lv_label_get_text"]
  property string text;
  [set="lv_label_set_recolor", get="lv_label_get_recolor"]
  property boolean recolor;

  enum LongMode {
    [value="LV_LABEL_LONG_WRAP"]
    WRAP,
    [value="LV_LABEL_LONG_DOT"]
    DOT,
    [value="LV_LABEL_LONG_SCROLL"]
    SCROLL,
    [value="LV_LABEL_LONG_SCROLL_CIRCULAR"]
    SCROLL_CIRCULAR,
    [value="LV_LABEL_LONG_CLIP"]
    CLIP,
  };

  [set="lv_label_set_long_mode", get="lv_label_get_long_mode"]
  property LongMode longMode;

  [set="lv_label_set_text_sel_start", get="lv_label_get_text_selection_start"]
  property int selectionStart;

  [set="lv_label_set_text_sel_end", get="lv_label_get_text_selection_end"]
  property int selectionEnd;

  [func="lv_label_ins_text"]
  void insertText(uint pos, string text);

  [func="lv_label_cut_text"]
  void cutText(uint pos, uint count);
}

