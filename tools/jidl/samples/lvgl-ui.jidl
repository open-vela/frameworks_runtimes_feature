  property int gridRowSpan writeonly;
  [set="lv_style_set_grid_cell_x_align"]
  property int gridCellXAlign writeonly;
  [set="lv_style_set_grid_cell_y_align"]
  property int gridCellYAlign writeonly;

  [func="lv_style_reset"]
  void reset();
};

Style createStyle(object style_data);

[value="LV_RADIUS_CIRCLE"]
const RADIUS_CIRCLE = 0;

[tag="inline-style"]
interface LocalStyle {

  [func="lv_obj_set_style_width"]
