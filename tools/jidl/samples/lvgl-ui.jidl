  property FlexAlign flexTrackAlign writeonly;
  [set="lv_style_set_flex_grow"]
  property int flexGrow writeonly;


  property int[] gridRows writeonly;
  property int[] gridColumns writeonly;

  [set="lv_style_set_grid_row_align"]
  property GridAlign gridRowAlign writeonly;
  [set="lv_style_set_grid_column_align"]
  property GridAlign gridColumnAlgin writeonly;
  [set="lv_style_set_grid_cell_column_pos"]
  property int gridColumnPos writeonly;
