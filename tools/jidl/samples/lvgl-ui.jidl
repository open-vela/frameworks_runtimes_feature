[
  native_type="lv_style_t*",
  from_native="from_style",
  to_native="to_style",
  finalizer="finalize_style",
  create="create_style",
  need_context=true,
  tag="style"
]
interface Style {

  [set="lv_style_set_width"]
  property int width writeonly;
  [set="lv_style_set_min_width"]
  property int minWidth writeonly;
  [set="lv_style_set_max_width"]
  property int maxWidth writeonly;

  [set="lv_style_set_height"]
  property int height writeonly;
  [set="lv_style_set_min_height"]
  property int minHeight writeonly;
  [set="lv_style_set_max_height"]
  property int maxHeight writeonly;

  [set="lv_style_set_x"]
  property int x writeonly;

  [set="lv_style_set_y"]
  property int y writeonly;

  [set="lv_style_set_align"]
  property Align align writeonly;

  [set="lv_style_set_transform_width"]
  property int transformWidth writeonly;
  [set="lv_style_set_transform_height"]
  property int transformHeight writeonly;
  [set="lv_style_set_translate_x"]
  property int translateX writeonly;
  [set="lv_style_set_translate_y"]
  property int translateY writeonly;
  [set="lv_style_set_transform_zoom"]
  property int transformZoom writeonly;
  [set="lv_style_set_transform_angle"]
  property int transformAngle writeonly;
  [set="lv_style_set_transform_pivot_x"]
  property int transformPivotX writeonly;
  [set="lv_style_set_transform_pivot_y"]
  property int transformPivotY writeonly;

  [set="lv_style_set_pad_top"]
  property int padTop writeonly;
  [set="lv_style_set_pad_bottom"]
  property int padBottom writeonly;
  [set="lv_style_set_pad_left"]
  property int padLeft writeonly;
  [set="lv_style_set_pad_right"]
  property int padRight writeonly;
  [set="lv_style_set_pad_all"]
  property int padding writeonly;
  [set="lv_style_set_pad_row"]
  property int padRow writeonly;
  [set="lv_style_set_pad_column"]
  property int padColumn writeonly;

  [set="lv_style_set_anim_time"]
  property int animateTime writeonly;

  /*
  [set="lv_style_set_margin_top"]
  property int marginTop writeonly;
  [set="lv_style_set_margin_bottom"]
  property int marginBottom writeonly;
  [set="lv_style_set_margin_left"]
  property int marginLeft writeonly;
  [set="lv_style_set_margin_right"]
  property int marginRight writeonly;
  */

  [set="lv_style_set_bg_color"]
  property lv_color_t bgColor writeonly;
  [set="lv_style_set_bg_opa"]
  property int bgOPA writeonly;
  [set="lv_style_set_bg_grad_color"]
  property lv_color_t bgGardColor writeonly;
  [set="lv_style_set_bg_grad_dir"]
  property int bgGradDir writeonly;
  [set="lv_style_set_bg_main_stop"]
  property int bgMainStop writeonly;
  [set="lv_style_set_bg_grad_stop"]
  property int bgGradStop writeonly;
  //[set="lv_style_set_bg_grad"]
  //property grad grad writeonly;
  [set="lv_style_set_bg_dither_mode"]
  property int bgDitherMode writeonly;

  [set="lv_style_set_bg_img_src"]
  property string bgImageSrc writeonly;
  [set="lv_style_set_bg_img_opa"]
  property int bgImageOPA writeonly;
  [set="lv_style_set_img_recolor"]
  property lv_color_t bgImageRecolor writeonly;
  [set="lv_style_set_bg_img_recolor_opa"]
  property int bgImageRecolorOPA writeonly;
  [set="lv_style_set_bg_img_tiled"]
