  [set="lv_style_set_border_color"]
  property lv_color_t borderColor writeonly;
  [set="lv_style_set_border_opa"]
  property int borderOPA writeonly;
  [set="lv_style_set_border_width"]
  property int borderWidth writeonly;
  [set="lv_style_set_border_side"]
  property BorderSide borderSide writeonly;
