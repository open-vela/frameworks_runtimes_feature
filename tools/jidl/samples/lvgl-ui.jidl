callback OnTimer(Timer timer);

[
  from_native="from_interface",
  to_native="to_interface",
  need_interface=true,
  native_type="lv_timer_t*",
  create="lv_timer_create_basic"
]
interface Timer {
  [func="lv_timer_pause"]
  void pause();

  [func="lv_timer_resume"]
  void resume();

  [set="lv_timer_set_period", field="period"]
  property uint period;

  [func="lv_timer_ready"]
  void ready();

  [set="lv_timer_set_repeat_count", field="repeat_count"]
  property uint repeatCount;

  [func="lv_timer_reset"]
  void reset();

  [rawset="js_timer_set_cb"]
  property OnTimer onTimer writeonly;

  [rawfunc="js_timer_delete"]
  void delete();
}

[func="lv_timer_enable", need_self=false]
void timerEnable(boolean en);

[func="lv_timer_get_idle", need_self=false]
int timerGetIdle();

[func="lv_anim_get_timer", need_self=false]
Timer getAnimationTimer();

