[
  native_type="lv_style_t*",
  from_native="from_style",
  to_native="to_style",
  finalizer="finalize_style",
  create="create_style",
  tag="style"
]
interface Style {

  [set="lv_style_set_width"] 
  property int width writeonly;
  [set="lv_style_set_min_width"]
  property int minWidth writeonly;
  [set="lv_style_set_max_width"]
  property int maxWidth writeonly;

  [set="lv_style_set_height"]
  property int height writeonly;
  [set="lv_style_set_min_height"]
  property int minHeight writeonly;
  [set="lv_style_set_max_height"]
  property int maxHeight writeonly;

  [set="lv_style_set_x"]
  property int x writeonly;

  [set="lv_style_set_y"]
  property int y writeonly;

  [set="lv_style_set_align"]
  property Align align writeonly;

  [set="lv_style_set_transform_width"]
  property int transformWidth writeonly;
  [set="lv_style_set_transform_height"]
  property int transformHeight writeonly;
  [set="lv_style_set_translate_x"]
  property int translateX writeonly;
  [set="lv_style_set_translate_y"]
  property int translateY writeonly;
  [set="lv_style_set_transform_zoom"]
  property int transformZoom writeonly;
  [set="lv_style_set_transform_angle"]
  property int transformAngle writeonly;
  [set="lv_style_set_transform_pivot_x"]
  property int transformPivotX writeonly;
  [set="lv_style_set_transform_pivot_y"]
  property int transformPivotY writeonly;

  [set="lv_style_set_pad_top"]
  property int padTop writeonly;
  [set="lv_style_set_pad_bottom"]
  property int padBottom writeonly;
  [set="lv_style_set_pad_left"]
  property int padLeft writeonly;
  [set="lv_style_set_pad_right"]
  property int padRight writeonly;
  [set="lv_style_set_pad_row"]
  property int padRow writeonly;
  [set="lv_style_set_pad_column"]
  property int padColumn writeonly;

  /*
  [set="lv_style_set_margin_top"]
  property int marginTop writeonly;
  [set="lv_style_set_margin_bottom"]
  property int marginBottom writeonly;
  [set="lv_style_set_margin_left"]
  property int marginLeft writeonly;
  [set="lv_style_set_margin_right"]
  property int marginRight writeonly;
  */

  [set="lv_style_set_bg_color"]
  property lv_color_t bgColor writeonly;
  [set="lv_style_set_bg_opa"]
  property int bgOPA writeonly;
  [set="lv_style_set_bg_grad_color"]
  property lv_color_t bgGardColor writeonly;
  [set="lv_style_set_bg_grad_dir"]
  property int bgGradDir writeonly;
  [set="lv_style_set_bg_main_stop"]
  property int bgMainStop writeonly;
  [set="lv_style_set_bg_grad_stop"]
  property int bgGradStop writeonly;
  //[set="lv_style_set_bg_grad"]
  //property grad grad writeonly;  
  [set="lv_style_set_bg_dither_mode"]
  property int bgDitherMode writeonly; 

  [set="lv_style_set_bg_img_src"]
  property string bgImageSrc writeonly;
  [set="lv_style_set_bg_img_opa"]
  property int bgImageOPA writeonly;
  [set="lv_style_set_img_recolor"]
  property lv_color_t bgImageRecolor writeonly;
  [set="lv_style_set_bg_img_recolor_opa"]
  property int bgImageRecolorOPA writeonly;
  [set="lv_style_set_bg_img_tiled"]
  property boolean bgImageTitle writeonly;

  // TODO src/misc/lv_style_gen.h
 

  [set="lv_obj_set_layout"]
  property int layout writeonly;

  // flex style
  [set="lv_style_set_flex_flow"]
  property FlexFlow flexFlow writeonly;
  [set="lv_style_set_flex_main_place"]
  property FlexAlign flexMainAlign writeonly;
  [set="lv_style_set_flex_cross_place"]
  property FlexAlign flexCrossAlign writeonly;
  [set="lv_style_set_flex_track_place"]
  property FlexAlign flexTrackAlign writeonly;
  [set="lv_style_set_flex_grow"]
  property int flexGrow writeonly;

  // grid
  [func="lv_obj_set_grid_dsc_array", param_pack=true, name="grid"]
  void setGridArray(int[] columns, int[] rows);

  [func="lv_obj_set_grid_cell"]
  void setGridCell(GridAlign column_align, int col_pos, int col_span, GridAlign row_align, int row_pos, int row_span);
};

Style createStyle(object style_data);

interface LocalStyle {

  [func="lv_obj_set_style_width"]
  void width(int value, uint selector);
  [func="lv_obj_set_style_min_width"]
  void minWidth(int value, uint selector);
  [func="lv_obj_set_style_max_width"]
  void maxWidth(int value, uint selector);

  [func="lv_obj_set_style_height"]
  void height(int value, uint selector);
  [func="lv_obj_set_style_min_height"]
  void minHeight(int value, uint selector);
  [func="lv_obj_set_style_max_height"]
  void maxHeight(int value, uint selector);

  [func="lv_obj_set_style_x"]
  void x(int value, uint selector);
  [func="lv_obj_set_style_y"]
  void y(int value, uint selector);

  [func="lv_obj_set_style_align"]
  void align(Align align, uint selector);

  [func="lv_obj_set_style_flex_flow"]
  void flexFlow(FlexFlow value, uint selector);
  [func="lv_obj_set_style_flex_main_place"]
  void flexMainAlign(FlexAlign value, uint selector);
  [func="lv_obj_set_style_flex_cross_place"]
  void flexCrossAlign(FlexAlign value, uint selector);
  [func="lv_obj_set_style_flex_track_place"]
  void flexTrackAlign(FlexAlign value, uint selector);
  [func="lv_obj_set_style_flex_grow"]
  void flexGrow(int value, uint selector);
};

[native_type="lv_event_t*"]
interface WidgetEvent {
  [get="lv_event_get_code"]
  property int code readonly;

  [get="lv_event_get_target"]
  property Widget target readonly;

  [get="lv_event_get_current_target"]
  property Widget current_target readonly;
};

callback event_cb(WidgetEvent evt);

[
  from_native="from_widget",
  to_native="to_widget",
  native_type="lv_obj_t*",
  finalizer="finalize_widget",
  need_parent=true,
  native_class="lv_obj_class"
]
interface Widget {
  [set="lv_obj_set_id", get="lv_obj_get_id"]
  property string id readonly;

  [set="lv_obj_set_x", get="lv_obj_get_x"]
  property int x;
  [set="lv_obj_set_y", get="lv_obj_get_y"]
  property int y;
  [set="lv_obj_set_width", get="lv_obj_get_width"]
  property int width;
  [set="lv_obj_set_height", get="lv_obj_get_height"]
  property int height;
  [set="lv_obj_set_content_width", get="lv_obj_get_content_width"]
  property int contentWidth;
  [set="lv_obj_set_content_height", get="lv_obj_get_content_height"]
  property int contentHeight;

  [set="lv_obj_set_align"]
  property Align align writeonly;

  [func="lv_obj_set_pos"]
  void setPos(int x, int y);
  [func="lv_obj_set_size"]
  void setSize(int width, int height);
  [func="lv_obj_set_layout"]
  void setLayout(int layout);

  [func="lv_obj_get_child"]
  Widget getChild(int id);

  void addStyle(object style, uint selector);

  void setStyle(object style);


  [func="lv_obj_add_flag"]
  void addFlag(Flag flag);
  [func="lv_obj_clear_flag"]
  void clearFlag(Flag flag);
  [func="lv_obj_has_flag"]
  boolean hasFlag(Flag flag);
  [func="lv_obj_has_flag_any"]
  boolean hasFlagAny(Flag flags);

  [func="lv_obj_add_state"]
  void addState(State state);
  [func="lv_obj_clear_state"]
  void clearState(State state);
  [get="lv_obj_get_state"]
  property State state readonly;
  [func="lv_obj_has_state"]
  boolean hasState(State state);

  [get="lv_obj_is_valid"]
  property boolean valid readonly;

  [func="lv_obj_dpx"]
  int dpx(int v);

  [set="lv_obj_set_flex_flow"]
  property FlexFlow flexFlow writeonly;

  [func="lv_obj_set_flex_align", param_pack=true, name="flexAlgin"]
  void setFlexAlign(FlexAlign main, FlexAlign cross, FlexAlign track_cross);

  [set="lv_obj_set_flex_grow"]
  property int flexGrow writeonly;
}

const LV_LABEL_LONG_WRAP = 0;
const LV_LABEL_LONG_DOT = 1;
const LV_LABEL_LONG_SCROLL = 2;
const LV_LABEL_LONG_SCROLL_CIRCULAR = 3;
const LV_LABEL_LONG_CLIP = 4;

[tag="label", create="lv_label_create", native_class="lv_label_class"]
interface Label extends Widget {
  [set="lv_label_set_text", get="lv_label_get_text"]
  property string text;
  [set="lv_label_set_recolor", get="lv_label_get_recolor"]
  property boolean recolor;

  enum LongMode {
    [value="LV_LABEL_LONG_WRAP"]
    WRAP,
    [value="LV_LABEL_LONG_DOT"]
    DOT,
    [value="LV_LABEL_LONG_SCROLL"]
    SCROLL,
    [value="LV_LABEL_LONG_SCROLL_CIRCULAR"]
    SCROLL_CIRCULAR,
    [value="LV_LABEL_LONG_CLIP"]
    CLIP,
  };

  [set="lv_label_set_long_mode", get="lv_label_get_long_mode"]
  property LongMode longMode;

  [set="lv_label_set_text_sel_start", get="lv_label_get_text_selection_start"]
  property int selectionStart;

  [set="lv_label_set_text_sel_end", get="lv_label_get_text_selection_end"]
  property int selectionEnd;

  [func="lv_label_ins_text"]
  void insertText(uint pos, string text);

  [func="lv_label_cut_text"]
  void cutText(uint pos, uint count);
}

[tag="button", create="lv_btn_create", native_class="lv_btn_class"]
interface Button extends Widget {
  [type="event", source_gen="event-call", code="LV_EVENT_CLICKED", event_type="WidgetEvent"]
  property event_cb onclick writeonly;
}

[tag="arc", create="lv_arc_create", native_class="lv_arc_class"]
interface Arc extends Widget {
  [set="lv_arc_set_start_angle", get="lv_arc_get_angle_start"]
  property int angleStart;
  [set="lv_arc_set_end_angle", get="lv_arc_get_angle_end"]
  property int angleEnd;
  [set="lv_arc_set_bg_start_angle", get="lv_arc_get_bg_angle_start"]
  property int bgAngleStart;
  [set="lv_arc_set_bg_end_angle", get="lv_arc_get_bg_angle_end"]
  property int bgAngleEnd;

  [set="lv_arc_set_rotation"]
  property int rotation writeonly;

  enum Mode {
    [value="LV_ARC_MODE_NORMAL"]
    NORMAL,
    [value="LV_ARC_MODE_SYMMETRICAL"]
    SYMMETRICAL,
    [value="LV_ARC_MODE_REVERSE"]
    REVERSE
  };
  [set="lv_arc_set_mode", get="lv_arc_get_mode"]
  property Mode mode;

  [set="lv_arc_set_value", get="lv_arc_get_value"]
  property int value;

  [set="lv_arc_set_min_value", get="lv_arc_get_min_value"]
  property int min;

  [set="lv_arc_set_max_value", get="lv_arc_get_max_value"]
  property int max;
  
  [set="lv_arc_set_change_rate"]
  property int changeRate writeonly;
}

[tag="bar", create="lv_bar_create", native_class="lv_bar_class"]
interface Bar extends Widget {
  [func="lv_bar_set_value", param_pack=true, name="value"]
  void setValue(int value, boolean animate);

  [func="lv_bar_set_start_value", param_pack=true, name="startValue"]
  void setStartValue(int value, boolean animate);

  [func="lv_bar_set_range", param_pack=true, name="range"]
  void setRange(int min, int max);

