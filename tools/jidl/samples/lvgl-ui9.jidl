[
  from_native="from_widget",
  to_native="to_widget",
  native_type="lv_obj_t*",
  finalizer="finalize_widget",
  need_parent=true,
  native_class="lv_obj_class",
  tag="widget",
  create="lv_obj_create"
]
interface Widget {
  [set="lv_obj_set_id", get="lv_obj_get_id"]
  property string id;

  [set="lv_obj_set_x", get="lv_obj_get_x"]
  property int x;
  [set="lv_obj_set_y", get="lv_obj_get_y"]
  property int y;
  [set="lv_obj_set_width", get="lv_obj_get_width"]
  property int width;
  [set="lv_obj_set_height", get="lv_obj_get_height"]
  property int height;
  [set="lv_obj_set_content_width", get="lv_obj_get_content_width"]
  property int contentWidth;
  [set="lv_obj_set_content_height", get="lv_obj_get_content_height"]
  property int contentHeight;

  [set="lv_obj_set_align"]
  property Align align writeonly;

  [func="lv_obj_set_pos"]
  void setPos(int x, int y);
  [func="lv_obj_set_size"]
  void setSize(int width, int height);
  [func="lv_obj_set_layout"]
  void setLayout(int layout);

  [func="lv_obj_get_child"]
  Widget getChild(int id);

  [param_pack="true", name="style"]
  void addStyle(object style, uint selector);

  [param_pack="true", name="inlineStyle"]
  void setStyle(object style);

  [func="lv_obj_remove_style_all"]
  void removeAllStyle();
  [func="lv_obj_remove_style"]
  void removeStyle(Style style, uint selector);


  [func="lv_obj_add_flag"]
  void addFlag(Flag flag);
  [func="lv_obj_clear_flag"]
  void clearFlag(Flag flag);
  [func="lv_obj_has_flag"]
  boolean hasFlag(Flag flag);
  [func="lv_obj_has_flag_any"]
  boolean hasFlagAny(Flag flags);

  [func="lv_obj_add_state"]
  void addState(State state);
  [func="lv_obj_clear_state"]
  void clearState(State state);
  [get="lv_obj_get_state"]
  property State state readonly;
  [func="lv_obj_has_state"]
  boolean hasState(State state);

  [get="lv_obj_is_valid"]
  property boolean valid readonly;


  [set="lv_obj_set_flex_flow"]
  property FlexFlow flexFlow writeonly;

  [func="lv_obj_set_flex_align", param_pack=true, name="flexAlgin"]
  void setFlexAlign(FlexAlign main, FlexAlign cross, FlexAlign track_cross);

  [set="lv_obj_set_flex_grow"]
  property int flexGrow writeonly;

  // grid
  [param_pack=true, name="grid"]
  void setGridArray(int[] columns, int[] rows);

  // events
  [type="event", source_gen="event-call", code="LV_EVENT_VALUE_CHANGED", event_type="WidgetEvent"]
  property event_cb onvaluechanged writeonly;
}

const LV_LABEL_LONG_WRAP = 0;
const LV_LABEL_LONG_DOT = 1;
const LV_LABEL_LONG_SCROLL = 2;
const LV_LABEL_LONG_SCROLL_CIRCULAR = 3;
const LV_LABEL_LONG_CLIP = 4;

[tag="label", create="lv_label_create", native_class="lv_label_class"]
