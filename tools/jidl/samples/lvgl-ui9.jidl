  property lv_color_t shadowColor writeonly;
  [set="lv_style_set_shadow_spread"]
  property int shadowSpread writeonly;
  [set="lv_style_set_shadow_opa"]
  property int shadowOPA writeonly;

  [set="lv_style_set_image_opa"]
  property int imageOPA writeonly;
  [set="lv_style_set_image_recolor"]
  property lv_color_t imageRecolor writeonly;
  [set="lv_style_set_image_recolor_opa"]
  property int imageRecolorOPA writeonly;

  [set="lv_style_set_line_width"]
  property int lineWidth writeonly;
  [set="lv_style_set_line_dash_width"]
  property int lineDashGap writeonly;
  [set="lv_style_set_line_rounded"]
  property boolean lineRounded writeonly;
  [set="lv_style_set_line_color"]
  property lv_color_t lineColor writeonly;
  [set="lv_style_set_line_opa"]
  property int lineOPA writeonly;

  [set="lv_style_set_arc_width"]
  property int arcWidth writeonly;
  [set="lv_style_set_arc_rounded"]
  property boolean arcRounded writeonly;
