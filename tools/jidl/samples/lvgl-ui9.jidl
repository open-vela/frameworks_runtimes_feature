[
  native_type="lv_anim_t*",
  tag="animation",
  from_native="jsvalue_from_anim",
  to_native="jsvalue_to_anim"
]
interface Animation {
  [rawset="NativeAnimateSetExecCb"]
  property anim_cb onExec writeonly;
  [rawset="NativeAnimateSetPathCb"]
  property anim_cb onPath writeonly;
  [rawset="NativeAnimateSetStartCb"]
  property anim_cb onStart writeonly;
  [rawset="NativeAnimateSetGetValueCb"]
  property anim_cb onGetValue writeonly;
  [rawset="NativeAnimateSetReadyCb"]
  property anim_cb onReady writeonly;
  [set="lv_anim_set_delay", get="lv_anim_get_delay"]
  property int delay;
  [func="lv_anim_set_values", param_pack=true, name="values"]
  void setValues(int start, int end);
  [set="lv_anim_set_time"]
  property int time writeonly;
  [set="lv_anim_set_playback_time", get="lv_anim_get_playtime"]
  property int playbackTime;
  [set="lv_anim_set_playback_delay"]
  property int playbackDelay writeonly;
  [set="lv_anim_set_repeat_count"]
  property int repeatCount writeonly;
  [set="lv_anim_set_repeat_delay"]
  property int repeatDelay writeonly;
  [set="lv_anim_set_early_apply"]
  property boolean earlyApply writeonly;
  [func="lv_anim_start"]
  void start();
};

