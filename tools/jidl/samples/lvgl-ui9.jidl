interface TextArea extends Widget {
  [func="lv_textarea_add_char"]
  void addChar(int chr);

  [func="lv_textarea_add_text"]
  void addText(string text);

  [func="lv_textarea_delete_char"]
  void deleteChar();

  [func="lv_textarea_delete_char_forward"]
  void deleteForwardChar();

  [set="lv_textarea_set_text", get="lv_textarea_get_text"]
  property string text;

  [set="lv_textarea_set_placeholder_text", get="lv_textarea_get_placeholder_text"]
  property string placeholderText;

  [set="lv_textarea_set_cursor_pos", get="lv_textarea_get_cursor_pos"]
  property int cursorPost;

  [set="lv_textarea_set_cursor_click_pos", get="lv_textarea_get_cursor_click_pos"]
  property boolean cursorClickPos;

  [set="lv_textarea_set_password_mode", get="lv_textarea_get_password_mode"]
  property boolean passwordMode;

  [set="lv_textarea_set_password_bullet", get="lv_textarea_get_password_bullet"]
  property string passwordBullet;

  [set="lv_textarea_set_one_line", get="lv_textarea_get_one_line"]
  property boolean oneLine;

  [set="lv_textarea_set_accepted_chars", get="lv_textarea_get_accepted_chars"]
  property string acceptedChars;

  [set="lv_textarea_set_max_length", get="lv_textarea_get_max_length"]
  property int maxLength;

  [set="lv_textarea_set_insert_replace"]
  property string insertReplace writeonly;

  [set="lv_textarea_set_text_selection", get="lv_textarea_get_text_selection"]
  property boolean textSelection;

  [set="lv_textarea_set_password_show_time", get="lv_textarea_get_password_show_time"]
  property int passwordShowTime;

  [set="lv_textarea_set_align"]
  property TextAlign align writeonly;

  [func="lv_textarea_clear_selection"]
  void clearSelection();

  [func="lv_textarea_cursor_right"]
  void moveCursorRight();

  [func="lv_textarea_cursor_left"]
  void moveCursorLeft();

  [func="lv_textarea_cursor_down"]
  void moveCursorDown();

  [func="lv_textarea_cursor_up"]
  void moveCursorUp();
}

/////////////////////////////////////////////////////////
boolean inflate(object parent, object param);

Widget findWidget(string id);
