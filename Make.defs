CONFIGURED_APPS += $(APPDIR)/frameworks/runtimes/feature

CXXFLAGS += ${INCDIR_PREFIX}$(APPDIR)/frameworks/runtimes/feature/include
CFLAGS += ${INCDIR_PREFIX}$(APPDIR)/frameworks/runtimes/feature/include
CXXFLAGS += ${INCDIR_PREFIX}$(APPDIR)/external/protobuf-c/protobuf-c
CFLAGS   += ${INCDIR_PREFIX}$(APPDIR)/external/protobuf-c/protobuf-c
ifeq ($(CONFIG_FEATURE_FRAMEWORK),y)
include $(APPDIR)/frameworks/runtimes/feature/modules/Make.defs
endif
ifeq ($(CONFIG_FEATURE_RUST_MODULES),y)
include $(APPDIR)/frameworks/runtimes/feature/rust/Make.defs
endif