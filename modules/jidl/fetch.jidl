struct FetchPara{
  string url;
  object data;
  object header;
  string method = "";   //MethodType
  string responseType = "";   //ResponseType
  int timeout = 20000;
}

[permissions="hapjs.permission.INTERNET"]
promise<object> fetch(FetchPara obj);
