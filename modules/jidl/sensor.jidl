module sensor @1.0

callback fail_cb(string data, int code)

struct AccelerometerRet {
    int x
    int y
    int z
}
callback accelerometer_cb(AccelerometerRet ret)
struct Accelerometer {
    boolean reserved = false
    string interval = "normal"
    callback accelerometer_cb cb
}
void subscribeAccelerometer(Accelerometer param)
void unsubscribeAccelerometer()

struct CompassRet {
    double direction
    double accuracy
}
callback compass_cb(CompassRet ret)
struct Compass {
    boolean reserved = false
    callback compass_cb cb
}
void subscribeCompass(Compass param)
void unsubscribeCompass()

struct ProximityRet {
    double distance
}
callback Proximity_cb(ProximityRet ret)
struct Proximity {
    boolean reserved = false
    callback Proximity_cb cb
    callback fail_cb fail
}
void subscribeProximity(Proximity param)
void unsubscribeProximity()

struct LightRet {
    double intensity
}
callback light_cb(LightRet ret)
struct Light {
    boolean reserved = false
    callback light_cb cb
}
void subscribeLight(Light param)
void unsubscribeLight()

struct StepCountRet {
    double steps
}
callback StepCount_cb(StepCountRet ret)
struct StepCount {
    boolean reserved = false
    callback StepCount_cb cb
    callback fail_cb fail
}
void subscribeStepCounter(StepCount param)
void unsubscribeStepCounter()

