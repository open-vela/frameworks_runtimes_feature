module system.sensor @1.0

callback fail_cb(string data, int code)

struct AccelerometerRet {
    int x
    int y
    int z
}
callback accelerometer_cb(AccelerometerRet ret)
struct Accelerometer {
    boolean reserved = false
    string interval = "normal"
    callback accelerometer_cb callback
    callback fail_cb fail
}
void subscribeAccelerometer(Accelerometer param)
void unsubscribeAccelerometer()

struct CompassRet {
    double direction
    double accuracy
}
callback compass_cb(CompassRet ret)
struct Compass {
    boolean reserved = false
    callback compass_cb callback
    callback fail_cb fail
}
void subscribeCompass(Compass param)
void unsubscribeCompass()

struct ProximityRet {
    double distance
}
callback Proximity_cb(ProximityRet ret)
struct Proximity {
    boolean reserved = false
    callback Proximity_cb callback
    callback fail_cb fail
}
void subscribeProximity(Proximity param)
void unsubscribeProximity()

struct LightRet {
    double intensity
}
callback light_cb(LightRet ret)
struct Light {
    boolean reserved = false
    callback light_cb callback
}
void subscribeLight(Light param)
void unsubscribeLight()

struct StepCountRet {
    double steps
}
callback StepCount_cb(StepCountRet ret)
struct StepCount {
    boolean reserved = false
    callback StepCount_cb callback
    callback fail_cb fail
}
void subscribeStepCounter(StepCount param)
void unsubscribeStepCounter()

struct BaroRet {
    double pressure
}
callback Baro_cb(BaroRet ret)
struct Baro {
    boolean reserved = false
    callback Baro_cb callback
    callback fail_cb fail
}
void subscribePressure(Baro param)
void unsubscribePressure()

struct HumidityRet {
    double humidity
}
callback Humidity_cb(HumidityRet ret)
struct Humidity {
    boolean reserved = false
    callback Humidity_cb callback
    callback fail_cb fail
}
void subscribeHumidity(Humidity param)
void unsubscribeHumidity()

struct TemperatureRet {
    double temperature
}
callback Temperature_cb(TemperatureRet ret)
struct Temperature {
    boolean reserved = false
    callback Temperature_cb callback
    callback fail_cb fail
}
void subscribeAmbientTemperature(Temperature param)
void unsubscribeAmbientTemperature()

const property object DATA_TYPES;

callback Subscribe_cb(object data)
struct subscribeParam{
    int type
    boolean reserved = false
    string interval = "low"
    callback Subscribe_cb callback
    callback fail_cb fail = null
}
int subscribe(subscribeParam param)

void unsubscribe(int type)

struct cb_param {
    object data
    int dataType
}

callback Success_cb(cb_param param)

callback sensor_complete_cb()

struct getRecentDataParam{
    int type
    callback Success_cb success
    callback fail_cb fail = null
    callback sensor_complete_cb complete = null
}
void getRecentData(getRecentDataParam param)

boolean checkAvailable(int type)