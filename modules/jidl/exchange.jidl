module service.exchange @1.0

callback success_cb(string value)
callback fail_cb(string errorMsg, int code)
callback complete_cb(string msg)

struct GetInfo {
    string package = ""
    string sign = ""
    string key
    string scope = "application"
    callback success_cb success
    callback fail_cb fail
    callback complete_cb complete
}

struct SetInfo {
    string key
    string value
    string scope = "application"
    callback success_cb success
    callback fail_cb fail
    callback complete_cb complete
    string package = ""
    string sign = ""
}

struct RemoveInfo {
    string key
    callback success_cb success
    callback fail_cb fail
    callback complete_cb complete
    string package = ""
    string sign = ""
}

struct ClearInfo {
    callback success_cb success
    callback fail_cb fail
    callback complete_cb complete
}

struct GrantPermissionInfo {
    string package
    string sign
    string key = ""
    boolean writable = false
    callback success_cb success
    callback fail_cb fail
    callback complete_cb complete
}

struct RevokePermissionInfo {
    string package
    string key = ""
    callback success_cb success
    callback fail_cb fail
    callback complete_cb complete
}

void set(SetInfo info)
void get(GetInfo info)
void remove(RemoveInfo info)
void clear(ClearInfo info)
void grantPermission(GrantPermissionInfo info)
void revokePermission(RevokePermissionInfo info)
