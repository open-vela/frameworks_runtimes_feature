module system.battery @1.0

struct getStatusRet {
    boolean charging
    double level
}

callback success_cb(getStatusRet ret)
callback fail_cb(string data, int code)
callback complete_cb()

struct getstatusParm {
    callback success_cb success
    callback fail_cb fail = null
    callback complete_cb complete = null
}

void getStatus(getstatusParm param)