module system.request@1.0

struct notify_data_t {
    int result
    int percent
}

struct download_succ_t {
    string token
}

callback download_notify_cb(notify_data_t data)
callback download_succ_cb(download_succ_t data)
callback download_fail_cb(string data, int code)
callback download_cmpl_cb()

struct download_t {
    string url
    string header
    string filename
    boolean share = true
    download_notify_cb onDownLoadNotify
    download_succ_cb success
    download_fail_cb fail
    download_cmpl_cb complete
}

[permissions="hapjs.permission.INTERNET"]
void download(download_t param)

struct dl_cmpl_succ_t {
    string uri
}
callback dl_cmpl_succ_cb(dl_cmpl_succ_t data)
callback dl_cmpl_fail_cb(string data, int code)
callback dl_cmpl_cmpl()

struct dl_cmpl_t {
    string token
    dl_cmpl_succ_cb success
    dl_cmpl_fail_cb fail
    dl_cmpl_cmpl complete
}
void onDownloadComplete(dl_cmpl_t param)
