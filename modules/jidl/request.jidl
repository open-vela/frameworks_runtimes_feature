module request@1.0

struct notify_data_t {
    int result
    int percent
}

struct download_succ_t {
    string token
}

callback cb_download_notify(notify_data_t data)
callback cb_download_success(download_succ_t data)
callback cb_download_fail(string data, int code)
callback cb_download_complete()

struct download_t {
    string url
    object header
    object filename
    boolean share = true
    cb_download_notify onDownLoadNotify
    cb_download_success success
    cb_download_fail fail
    cb_download_complete complete
}

void download(download_t param)

struct dl_cmpl_succ_t {
    string uri
}
callback cb_dl_cp_success(dl_cmpl_succ_t data)
callback cb_dl_cp_fail(string data, long code)
callback cb_dl_cp_complete()

struct dl_cmpl_t {
    string token
    cb_dl_cp_success success
    cb_dl_cp_fail fail
    cb_dl_cp_complete complete
}
void onDownloadComplete(dl_cmpl_t param)

void print(...)
