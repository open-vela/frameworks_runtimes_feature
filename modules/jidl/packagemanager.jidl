module system.packagemanager@1.0

struct PackageItem {
    string package
    string operation  // "install" | "uninstall"
}

struct PackageInfo {
    string package
    string appName
    string appIcon
    int versionCode
    string versionName
    int minAPILevel
    string[] permissions
    int appSize
    object extra
    boolean isSystem
}

struct ProgressChangeEvent {
    string package
    int progress  // 0-100
}

struct StatusChangeEvent {
    string package
    string operation  // "install" | "uninstall"
    string status     // "success" | "fail"
    string msg
    int code       // 0 | 5101 | 4102
}

struct SucessObj {
    boolean result
}

struct nullPara {
    object placeHolder = null
}

// ------------------------ Promise 风格接口定义 ------------------------
// 检测应用是否安装
struct HasInstalledOptions {
    string package
    string type = "package"  // "widget" | "package"
}
promise<SucessObj> hasInstalled(HasInstalledOptions options)

// 安装应用
struct InstallOptions {
    string uri
    boolean force = false
}
promise<SucessObj> install(InstallOptions options)

// 卸载应用
struct UnInstalledOptions {
    string package
}
promise<SucessObj> uninstall(UnInstalledOptions options)

// 获取应用信息
struct GetPackageInfoOptions {
    string package
}
promise<PackageInfo> getPackageInfo(GetPackageInfoOptions options)

// 获取已安装应用列表
promise<PackageInfo[]> getInstalledPackages(nullPara para)

// 获取操作中的应用列表
promise<PackageItem[]> getPackagesInOperation(nullPara para)

// 清除应用数据
struct ClearPackageDataOptions {
    string package
}
promise<SucessObj> clearPackageData(ClearPackageDataOptions options)

// 进度变化事件
event onprogresschange(ProgressChangeEvent event);

// 状态变化事件
event onstatuschange(StatusChangeEvent event);
