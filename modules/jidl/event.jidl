module system.event@1.0

struct option_t {
    object params = null
    string[] permissions
}

struct publish_t {
    string eventName
    option_t options = null
}

void publish(publish_t param)

struct subs_cb_t {
    object params
    string package
}

callback subscribe_cb(subs_cb_t data)

struct sub_t {
    string eventName
    subscribe_cb callback
}
object subscribe(sub_t param)

struct unsubs_t {
    int id
}
void unsubscribe(unsubs_t param)
