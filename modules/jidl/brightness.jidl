module system.brightness @1.0

struct GetValueModeSuccCBParam {
    int value
    int mode
}

callback getValue_succ_cb(GetValueModeSuccCBParam cb)
callback getValue_fail_cb(string msg, int code)
callback getValue_comp_cb()

struct GetValueParam {
    getValue_succ_cb success
    getValue_fail_cb fail
    getValue_comp_cb complete
}

void getValue(GetValueParam param)
////////////////////////////////////////////////////
callback setValue_succ_cb()
callback setValue_fail_cb(string msg, int code)
callback setValue_comp_cb()

struct SetValueParam {
    int value
    setValue_succ_cb success
    setValue_fail_cb fail
    setValue_comp_cb complete
}

void setValue(SetValueParam param)
////////////////////////////////////////////////////
struct GetModeParam {
    getValue_succ_cb success
    getValue_fail_cb fail
    getValue_comp_cb complete
}
void getMode(GetModeParam param)
////////////////////////////////////////////////////
struct SetModeParam {
    int mode
    setValue_succ_cb success
    setValue_fail_cb fail
    setValue_comp_cb complete
}
void setMode(SetModeParam param);
////////////////////////////////////////////////////
struct SetKeepScreenOnParam {
    boolean keepScreenOn
    setValue_succ_cb success
    setValue_fail_cb fail
    setValue_comp_cb complete
}

void setKeepScreenOn(SetKeepScreenOnParam param);
////////////////////////////////////////////////////

callback on_data(object data);
property on_data onbrightnesschanged writeonly;
property on_data onmodechanged writeonly;