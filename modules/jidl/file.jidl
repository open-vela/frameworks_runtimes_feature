module system.file@1.0

// move
callback move_succ_cb(string uri)
callback move_fail_cb(string msg, int code)
callback move_cmpl_cb()

struct move_param_t {
    string srcUri
    string dstUri
    move_succ_cb success
    move_fail_cb fail
    move_cmpl_cb complete
}
void move(move_param_t param)

// copy
callback copy_succ_cb(string uri)
callback copy_fail_cb(string msg, int code)
callback copy_cmpl_cb()

struct copy_param_t {
    string srcUri
    string dstUri
    copy_succ_cb success
    copy_fail_cb fail
    copy_cmpl_cb complete
}
void copy(copy_param_t param)

// list
struct file_info_t {
    string uri
    int length
    long lastModifiedTime
}

struct list_succ_param {
    file_info_t[] fileList;
}
callback list_succ_cb(list_succ_param param)
callback list_fail_cb(string msg, int code)
callback list_cmpl_cb()

struct list_param_t {
    string uri
    list_succ_cb success
    list_fail_cb fail
    list_cmpl_cb complete
}
void list(list_param_t param)

// get
struct extended_file_info_t {
    string uri
    int length
    long lastModifiedTime
    string type
    extended_file_info_t[] subFiles;
}
callback get_succ_cb(extended_file_info_t uri)
callback get_fail_cb(string msg, int code)
callback get_cmpl_cb()

struct get_param_t {
    string uri
    boolean recursive = false
    get_succ_cb success
    get_fail_cb fail
    get_cmpl_cb complete
}
void get(get_param_t param)

// delete
callback delete_succ_cb()
callback delete_fail_cb(string msg, int code)
callback delete_cmpl_cb()

struct delete_param_t {
    string uri
    delete_succ_cb success
    delete_fail_cb fail
    delete_cmpl_cb complete
}
void delete(delete_param_t param)

// writeText
callback writeText_succ_cb()
callback writeText_fail_cb(string msg, int code)
callback writeText_cmpl_cb()

struct write_text_param_t {
    string uri
    string text
    string encoding = "UTF-8"
    boolean append = false
    writeText_succ_cb success
    writeText_fail_cb fail
    writeText_cmpl_cb complete
}
void writeText(write_text_param_t param)

// writeArrayBuffer
callback writeArrBuf_succ_cb()
callback writeArrBuf_fail_cb(string msg, int code)
callback writeArrBuf_cmpl_cb()

struct write_arr_buf_param_t {
    string uri
    object buffer // uint8Array
    int position = 0
    boolean append = false
    writeArrBuf_succ_cb success
    writeArrBuf_fail_cb fail
    writeArrBuf_cmpl_cb complete
}
void writeArrayBuffer(write_arr_buf_param_t param)

// readText
struct read_txt_succ_t {
    string text
}
callback readText_succ_cb(read_txt_succ_t data)
callback readText_fail_cb(string msg, int code)
callback readText_cmpl_cb()

struct read_text_param_t {
    string uri
    string encoding = "UTF-8"
    readText_succ_cb success
    readText_fail_cb fail
    readText_cmpl_cb complete
}
void readText(read_text_param_t param)

// readArrayBuffer
struct read_arr_buf_succ_t {
    object buffer // uint8Array
}
callback readArrBuf_succ_cb(read_arr_buf_succ_t data)
callback readArrBuf_fail_cb(string msg, int code)
callback readArrBuf_compl_cb()

struct read_arr_buf_t {
    string uri
    int position = 0
    // default length = INT32_MIN
    int length = -2147483648
    readArrBuf_succ_cb success
    readArrBuf_fail_cb fail
    readArrBuf_compl_cb complete
}
void readArrayBuffer(read_arr_buf_t param)

// access
callback access_succ_cb()
callback access_fail_cb(string msg, int code)
callback access_compl_cb()

struct access_param_t {
    string uri
    access_succ_cb success
    access_fail_cb fail
    access_compl_cb complete
}
void access(access_param_t param)

// mkdir
callback mkdir_succ_cb()
callback mkdir_fail_cb(string msg, int code)
callback mkdir_compl_cb()

struct mkdir_param_t {
    string uri
    boolean recursive = false
    mkdir_succ_cb success
    mkdir_fail_cb fail
    mkdir_compl_cb complete
}
void mkdir(mkdir_param_t param)

// rmdir
callback rmdir_succ_cb()
callback rmdir_fail_cb(string msg, int code)
callback rmdir_cmpl_cb()

struct rmdir_param_t {
    string uri
    boolean recursive = false
    rmdir_succ_cb success
    rmdir_fail_cb fail
    rmdir_cmpl_cb complete
}
void rmdir(rmdir_param_t param)
