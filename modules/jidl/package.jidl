module system.internal.package@1.0

struct PackageInfo {
    string packageName
    string name
    string icon
    string installedPath
    string manifest
    string appType
    string version
    string installTime
    int appSize
    string extra
}

callback installProgress_cb(string packageName,int progress)
callback installResult_cb(string packageName,int code,string msg)
struct InstallInfo {
    string path
    boolean isForce = false
    callback installProgress_cb progress
    callback installResult_cb result
}

callback uninstallResult_cb(string packageName,int code,string msg)
struct UninstallInfo {
    string packageName
    boolean isClearCache = false
    callback uninstallResult_cb result
}

string[] getAllPackageInfo()
PackageInfo getPackageInfo(string packageName)
int clearAppCache(string packageName)
void installPackage(InstallInfo info)
void uninstallPackage(UninstallInfo info)
