module system.cipher@1.0

/*
const enum ActionType {
  ENCRYPT = 'encrypt',
  DECRYPT = 'decrypt'
}

enum HashType {
  MD5 = 'MD5',
  SHA1 = 'SHA1',
  SHA256 = 'SHA256',
  SHA512 = 'SHA512'
}
*/

callback success_cb_obj_bool_opt(object data) // ? boolean
callback success_cb_obj_str_opt(object res) // ? { text: string }

callback fail_cb(object data, int code)
callback complete_cb()

/**
 * encrypt or decrypt text using rsa algorithm
 * @param opts
 */
struct RSAParam {
  string action  // ActionType
  string text  // text to be encrypted or decrypted
  string key  // rsa secret key
  string hashType = "SHA256" // ? HashType
  callback success_cb_obj_str_opt success // ?
  callback fail_cb fail // ?
  callback complete_cb complete // ?
}
void rsa(RSAParam opts)


/**
 * RSA sign
 * @param opts
 */
void sign(RSAParam opts)


/**
 * RSA sign verify
 * @param opts
 */
struct RSAVerifyParam {
  string text  // text to be encrypted or decrypted
  string key  // rsa secret key
  string hashType = "SHA256" // ? HashType
  string signature  // ?
  callback success_cb_obj_bool_opt success // ?
  callback fail_cb fail // ?
  callback complete_cb complete // ?
}
void verify(RSAVerifyParam opts)


/**
 * digest
 * @param opts
 */
struct DigestParam {
  string hashType = "SHA256" // ? HashType
  string text  // text to be encrypted or decrypted
  callback success_cb_obj_str_opt success // ?
  callback fail_cb fail // ?
  callback complete_cb complete // ?
}
void digest(DigestParam opts)


/**
 * md5
 * @param opts
 */
struct Md5Param {
  string text
  callback success_cb_obj_str_opt success // ?
  callback fail_cb fail // ?
  callback complete_cb complete // ?
}
void md5(Md5Param opts)


/**
 * encrypt or decrypt text using aes algorithm
 * @param opts
 */
struct AESParam {
  string action  // ActionType
  string text  // text to be encrypted or decrypted
  string key  // aes secret key
  string iv  // ?
  int ivOffset = 0 // ?
  int ivLen = 16 // ?
  callback success_cb_obj_str_opt success // ?
  callback fail_cb fail // ?
  callback complete_cb complete // ?
}
void aes(AESParam opts)
