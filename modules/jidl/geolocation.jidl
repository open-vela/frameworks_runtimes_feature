module system.geolocation @1.0

struct getLocationRet {
    double longitude
    double latitude
    double altitude
    double speed
    int accuracy
    object accuracyInfo
}

struct getParam {
    int timeout = 30000
}

[permissions="hapjs.permission.LOCATION"]
promise<getLocationRet> getLocation(getParam param)

callback subscribe_cb(getLocationRet ret)
callback geolocation_fail_cb(string data, int code)
struct subscribeParam {
    callback subscribe_cb callback
    callback geolocation_fail_cb fail = null
}

[permissions="hapjs.permission.LOCATION"]
void subscribe(subscribeParam param)

[permissions="hapjs.permission.LOCATION"]
void unsubscribe()