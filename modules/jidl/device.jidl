module system.device@1.0

struct Device {
    string brand
    string IMEI
    string manufacturer
    string model
    string product
    string osType
    string osVersionName
    int osVersionCode
    string platformVersionName
    int platformVersionCode
    int APILevel
    string language
    string region
    int screenWidth
    int screenHeight
    string deviceType
    string screenShape
    string deviceId;
    string serial;
    string totalStorage;
    string availableStorage;
}

callback success_cb(Device device)
callback fail_cb(string data, int code)
callback complete_cb()

struct CallBack {
    callback success_cb success
    callback fail_cb fail
    callback complete_cb complete
}

Device getInfo(CallBack cb)
string getDeviceId(CallBack cb)
string getId(CallBack cb)
string getSerial(CallBack cb)
string getTotalStorage(CallBack cb)
string getAvailableStorage(CallBack cb)
