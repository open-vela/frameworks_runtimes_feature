module system.device@1.0

struct Device {
    string brand
    string IMEI
    string manufacturer
    string model
    string product
    string osType
    string osVersionName
    int osVersionCode
    string platformVersionName
    int platformVersionCode
    int APILevel
    string language
    string region
    int screenWidth
    int screenHeight
    string deviceType
    string screenShape
    double screenDensity
    string miProductId
    string deviceModel
    string miDeviceAlias
}

callback getinfo_success_cb(Device device)
callback common_success_cb(object device)

callback fail_cb(string data, int code)
callback complete_cb()

struct getinfo_params {
    callback getinfo_success_cb success
    callback fail_cb fail
    callback complete_cb complete
}

struct common_params {
    callback common_success_cb success
    callback fail_cb fail
    callback complete_cb complete
}


void getInfo(getinfo_params cb)

[permissions="hapjs.permission.DEVICE_INFO"]
string getDeviceId(common_params cb = null)
void getId(common_params cb)

[permissions="hapjs.permission.DEVICE_INFO"]
void getSerial(common_params cb)
void getTotalStorage(common_params cb)
void getAvailableStorage(common_params cb)
