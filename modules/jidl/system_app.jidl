module system.app@1.0

struct AppSource {
    string packageName
    string type
}

struct AppInfo {
    string packageName
    string name
    string versionName
    int versionCode
    string icon
    string logLevel
    struct AppSource source
}

AppInfo getInfo();

void terminate();

boolean canIUse(object feature_method = null);

object loadLibrary(string library_name);