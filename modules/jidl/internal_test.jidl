module system.internal.test@1.0

struct ExtraDeviceInfo {
    int bpp
}

callback get_extra_info_success_cb(ExtraDeviceInfo info)
callback get_extra_info_fail_cb(string data, int code)
callback get_extra_info_complete_cb()

struct get_extra_info_params {
    callback get_extra_info_success_cb success
    callback get_extra_info_fail_cb fail
    callback get_extra_info_complete_cb complete
}

void getExtraDeviceInfo(get_extra_info_params parm)