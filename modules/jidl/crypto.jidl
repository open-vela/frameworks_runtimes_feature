module system.crypto@1.0

/*
const enum AlgoType {
  RSA = 'RSA',
  AES = 'AES'
}

enum HashType {
  MD5 = "MD5",
  SHA1 = "SHA1",
  SHA256 = "SHA256",
  SHA512 = "SHA512"
}

enum SignHashType {
  MD5 = 'RSA-MD5',
  SHA1 = 'RSA-SHA1',
  SHA256 = 'RSA-SHA256',
  SHA512 = 'RSA-SHA512'
}
*/

/**
 * hashDigest
 * @param options
 */
struct HashDigestParam {
  object data  // ? string | Uint8Array
  string uri  // ?
  string algo = "SHA256" // ? HashType
}
string hashDigest(HashDigestParam options)

callback success_cb_bool_opt(boolean data) // ? boolean
callback success_cb_obj_str_opt(object res) // ? string
callback success_cb_obj_str_u8a_opt(object res) // ? string | Uint8Array

callback fail_cb(string data, int code)
callback complete_cb()

/**
 * compute hmacDigest
 * @param options
 */
struct HmacDigestParam {
  string data
  string algo = "SHA256" // ? HashType
  string key
  callback success_cb_obj_str_opt success // ?
  callback fail_cb fail // ?
  callback complete_cb complete // ?
}
void hmacDigest(HmacDigestParam options)

/**
 * RSA sign
 * @param options
 */
struct SignParam {
  object data  // ? string | Uint8Array
  string uri  // ?
  string algo = "RSA-SHA256" // ? SignHashType
  string privateKey
  callback success_cb_obj_str_u8a_opt success // ?
  callback fail_cb fail // ?
  callback complete_cb complete // ?
}
void sign(SignParam options)

/**
 * RSA sign verify
 * @param options
 */
struct RSAVerifyParam {
  object data  // ? string | Uint8Array
  string uri  // ?
  string algo = "RSA-SHA256" // ? SignHashType
  object signature
  string publicKey
  callback success_cb_bool_opt success // ?
  callback fail_cb fail // ?
  callback complete_cb complete // ?
}
void verify(RSAVerifyParam options)


/**
 * encrypt using rsa algorithm or aes algorithm
 * @param options
 */
struct MixinCryptOption {
  string transformation = "AES/CBC/PKCS7Padding"
  string iv = ""
  int ivOffset = 0
  int ivLen = 0
  object aad = null  // string | Uint8Array
  int tagLen = 4
  object tag = null  // string | Uint8Array
}
struct CryptParam {
  object data  // string | Uint8Array
  string algo = "RSA"
  object key  // string | Uint8Array
  struct MixinCryptOption options = null
  callback success_cb_obj_str_u8a_opt success = null
  callback fail_cb fail = null
  callback complete_cb complete = null
}
void encrypt(CryptParam options)

/**
 * decrypt using rsa algorithm or aes algorithm
 * @param options
 */
void decrypt(CryptParam options)

/**
 * convert string into base64
 * @param text
 * @returns
 */
string btoa(string text)

/**
 * convert base64 into string
 * @param text
 * @returns
 */
string atob(string text)

/**
 * deliver hkdf key
 * @param text
 * @returns
 */
struct HkdfParam {
  string algo = ""
  object key
  object salt
  object info
  int keyLen
  callback success_cb_obj_str_u8a_opt success = null
  callback fail_cb fail = null
  callback complete_cb complete = null
}
void hkdf(HkdfParam options)

struct CurveParam {
  string encoding = ""
  callback success_cb_obj_str_u8a_opt success = null
  callback fail_cb fail = null
  callback complete_cb complete = null
}


struct ComputeParam {
  object otherPublicKey
  string inputEncoding = ""
  string outputEncoding = ""
  callback success_cb_obj_str_u8a_opt success = null
  callback fail_cb fail = null
  callback complete_cb complete = null
}

struct setPrivateKeyParam {
  object privateKey;
  callback success_cb_obj_str_u8a_opt success = null
  callback fail_cb fail = null
  callback complete_cb complete = null
}

interface ECDH {
  void generateKeys(CurveParam param) // return a String/Uint8Array object
  object getPrivateKey(string encoding) // if key is base64/hex return a "hex" value. if key is buffer return "Uint8Array" value
  object getPublicKey(string encoding) // if key is base64/hex return "hex" value. if key is buffer return "Uint8Array" value
  void setPrivateKey(setPrivateKeyParam pram) // set private key with encoding param
  void computeSecret(ComputeParam param) // return a String/Uint8Array which is computed by publicKey param
}
[ctor="true", target="ECDH_imp"] ECDH createECDH (string type);
