module system.vibrator @1.0

struct VibrateDataRet {
    int id = 0
}

callback success_cb(VibrateDataRet data)
callback fail_cb(string data, int code)
callback complete_cb()

struct VibrateObject {
    string mode = "long"
}

struct StartObject {
    int duration = 0
    int interval = 0
    int count = 0
    callback success_cb success = null
    callback fail_cb fail = null
    callback complete_cb complete = null
}

void vibrate(VibrateObject obj)
void start(StartObject obj)
int stop(int id)
int getSystemDefaultMode()