module system.storage @1.0

callback success_cb(string value)
callback fail_cb(string errorMsg, int code)
callback complete_cb(string msg)

struct GetInfo {
    string key
    string default = ""
    callback success_cb success
    callback fail_cb fail
    callback complete_cb complete
}

struct SetInfo {
    string key
    string value = ""
    callback success_cb success
    callback fail_cb fail
    callback complete_cb complete
}

struct ClearInfo {
    callback success_cb success
    callback fail_cb fail
    callback complete_cb complete
}

struct DeleteInfo {
    string key
    callback success_cb success
    callback fail_cb fail
    callback complete_cb complete
}

struct KeyInfo {
    int index
    callback success_cb success
    callback fail_cb fail
    callback complete_cb complete
}

void get(GetInfo info)
void get_sync(GetInfo info)
void set(SetInfo info)
void clear(ClearInfo info)
void delete(DeleteInfo info)
void key(KeyInfo info)

property int length