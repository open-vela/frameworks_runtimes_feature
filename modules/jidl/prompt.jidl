module system.prompt @1.0

struct SuccessInfo {
    int index
}

callback success_cb(SuccessInfo value)
callback cancel_cb()
callback complete_cb()

struct ToastInfo {
    string message
    object duration
}

struct button {
    string text
    string color
}

struct DialogInfo {
    string title = ""
    string message
    boolean autocancel = true
    callback success_cb success
    callback cancel_cb cancel
    callback complete_cb complete
}

void showToast(ToastInfo info)
void showDialog(DialogInfo info)
