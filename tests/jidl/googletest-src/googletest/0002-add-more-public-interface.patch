From d8516ff606f84225ec56fb2cd51ec44a3ab2d489 Mon Sep 17 00:00:00 2001
From: gaoyulong <gaoyulong@xiaomi.com>
Date: Mon, 16 Oct 2023 10:32:57 +0800
Subject: [PATCH 2/7] add more public interface

---
 googletest/0001-seperate-unitttest.patch      | 113 ++++++++++++++++++
 googletest/include/gtest/gtest.h              |  10 ++
 .../include/gtest/internal/gtest-internal.h   |   6 +
 googletest/src/gtest-internal-inl.h           |   4 +
 googletest/src/gtest.cc                       |  13 ++
 5 files changed, 146 insertions(+)
 create mode 100644 googletest/0001-seperate-unitttest.patch

diff --git a/googletest/0001-seperate-unitttest.patch b/googletest/0001-seperate-unitttest.patch
new file mode 100644
index 0000000..b97881e
--- /dev/null
+++ b/googletest/0001-seperate-unitttest.patch
@@ -0,0 +1,113 @@
+From f3d83d694586b844f3d961ee78ec0934041561d5 Mon Sep 17 00:00:00 2001
+From: gaoyulong <gaoyulong@xiaomi.com>
+Date: Thu, 14 Sep 2023 11:55:08 +0800
+Subject: [PATCH] seperate unitttest
+
+---
+ include/gtest/gtest.h                   | 10 ++++++++++
+ include/gtest/internal/gtest-internal.h |  6 ++++++
+ src/gtest-internal-inl.h                |  4 ++++
+ src/gtest.cc                            | 13 +++++++++++++
+ 4 files changed, 33 insertions(+)
+
+diff --git a/include/gtest/gtest.h b/include/gtest/gtest.h
+index 7963e8c..8e77d3b 100644
+--- a/include/gtest/gtest.h
++++ b/include/gtest/gtest.h
+@@ -186,6 +186,7 @@ class UnitTestRecordPropertyTestHelper;
+ class WindowsDeathTest;
+ class FuchsiaDeathTest;
+ class UnitTestImpl* GetUnitTestImpl();
++class UnitTestImpl* GetUnitTestImpl(UnitTest* u);
+ void ReportFailureInUnknownLocation(TestPartResult::Type result_type,
+                                     const std::string& message);
+ std::set<std::string>* GetIgnoredParameterizedTestSuites();
+@@ -606,6 +607,12 @@ class GTEST_API_ TestInfo {
+       internal::TypeId fixture_class_id, internal::SetUpTestSuiteFunc set_up_tc,
+       internal::TearDownTestSuiteFunc tear_down_tc,
+       internal::TestFactoryBase* factory);
++  friend TestInfo* internal::UnitTestMakeAndRegisterTestInfo(UnitTest* u,
++      const char* test_suite_name, const char* name, const char* type_param,
++      const char* value_param, internal::CodeLocation code_location,
++      internal::TypeId fixture_class_id, internal::SetUpTestSuiteFunc set_up_tc,
++      internal::TearDownTestSuiteFunc tear_down_tc,
++      internal::TestFactoryBase* factory);
+ 
+   // Constructs a TestInfo object. The newly constructed instance assumes
+   // ownership of the factory object.
+@@ -1107,6 +1114,8 @@ class GTEST_API_ UnitTest {
+   // is called, a UnitTest object is constructed and returned.
+   // Consecutive calls will return the same object.
+   static UnitTest* GetInstance();
++  static UnitTest* Create() { return new UnitTest; }
++  static void Delete(UnitTest* u) { if (u) delete u; }
+ 
+   // Runs all tests in this UnitTest object and prints the result.
+   // Returns 0 if successful, or 1 otherwise.
+@@ -1267,6 +1276,7 @@ class GTEST_API_ UnitTest {
+   friend Environment* AddGlobalTestEnvironment(Environment* env);
+   friend std::set<std::string>* internal::GetIgnoredParameterizedTestSuites();
+   friend internal::UnitTestImpl* internal::GetUnitTestImpl();
++  friend internal::UnitTestImpl* internal::GetUnitTestImpl(UnitTest* u);
+   friend void internal::ReportFailureInUnknownLocation(
+       TestPartResult::Type result_type, const std::string& message);
+ 
+diff --git a/include/gtest/internal/gtest-internal.h b/include/gtest/internal/gtest-internal.h
+index e9c2441..5a7537c 100644
+--- a/include/gtest/internal/gtest-internal.h
++++ b/include/gtest/internal/gtest-internal.h
+@@ -583,6 +583,12 @@ GTEST_API_ TestInfo* MakeAndRegisterTestInfo(
+     TypeId fixture_class_id, SetUpTestSuiteFunc set_up_tc,
+     TearDownTestSuiteFunc tear_down_tc, TestFactoryBase* factory);
+ 
++GTEST_API_ TestInfo* UnitTestMakeAndRegisterTestInfo(UnitTest* u,
++    const char* test_suite_name, const char* name, const char* type_param,
++    const char* value_param, CodeLocation code_location,
++    TypeId fixture_class_id, SetUpTestSuiteFunc set_up_tc,
++    TearDownTestSuiteFunc tear_down_tc, TestFactoryBase* factory);
++
+ // If *pstr starts with the given prefix, modifies *pstr to be right
+ // past the prefix and returns true; otherwise leaves *pstr unchanged
+ // and returns false.  None of pstr, *pstr, and prefix can be NULL.
+diff --git a/src/gtest-internal-inl.h b/src/gtest-internal-inl.h
+index 8c650e0..948b70d 100644
+--- a/src/gtest-internal-inl.h
++++ b/src/gtest-internal-inl.h
+@@ -961,6 +961,10 @@ inline UnitTestImpl* GetUnitTestImpl() {
+   return UnitTest::GetInstance()->impl();
+ }
+ 
++inline UnitTestImpl* GetUnitTestImpl(UnitTest* u) {
++  return u->impl();
++}
++
+ #if GTEST_USES_SIMPLE_RE
+ 
+ // Internal helper functions for implementing the simple regular
+diff --git a/src/gtest.cc b/src/gtest.cc
+index 3859452..7bf20b7 100644
+--- a/src/gtest.cc
++++ b/src/gtest.cc
+@@ -2769,6 +2769,19 @@ TestInfo* MakeAndRegisterTestInfo(
+   return test_info;
+ }
+ 
++
++TestInfo* UnitTestMakeAndRegisterTestInfo(
++    UnitTest* u, const char* test_suite_name, const char* name,
++    const char* type_param, const char* value_param, CodeLocation code_location,
++    TypeId fixture_class_id, SetUpTestSuiteFunc set_up_tc,
++    TearDownTestSuiteFunc tear_down_tc, TestFactoryBase* factory) {
++  TestInfo* const test_info =
++      new TestInfo(test_suite_name, name, type_param, value_param,
++                   code_location, fixture_class_id, factory);
++  GetUnitTestImpl(u)->AddTestInfo(set_up_tc, tear_down_tc, test_info);
++  return test_info;
++}
++
+ void ReportInvalidTestSuiteType(const char* test_suite_name,
+                                 CodeLocation code_location) {
+   Message errors;
+-- 
+2.25.1
+
diff --git a/googletest/include/gtest/gtest.h b/googletest/include/gtest/gtest.h
index 7963e8c..8e77d3b 100644
--- a/googletest/include/gtest/gtest.h
+++ b/googletest/include/gtest/gtest.h
@@ -186,6 +186,7 @@ class UnitTestRecordPropertyTestHelper;
 class WindowsDeathTest;
 class FuchsiaDeathTest;
 class UnitTestImpl* GetUnitTestImpl();
+class UnitTestImpl* GetUnitTestImpl(UnitTest* u);
 void ReportFailureInUnknownLocation(TestPartResult::Type result_type,
                                     const std::string& message);
 std::set<std::string>* GetIgnoredParameterizedTestSuites();
@@ -606,6 +607,12 @@ class GTEST_API_ TestInfo {
       internal::TypeId fixture_class_id, internal::SetUpTestSuiteFunc set_up_tc,
       internal::TearDownTestSuiteFunc tear_down_tc,
       internal::TestFactoryBase* factory);
+  friend TestInfo* internal::UnitTestMakeAndRegisterTestInfo(UnitTest* u,
+      const char* test_suite_name, const char* name, const char* type_param,
+      const char* value_param, internal::CodeLocation code_location,
+      internal::TypeId fixture_class_id, internal::SetUpTestSuiteFunc set_up_tc,
+      internal::TearDownTestSuiteFunc tear_down_tc,
+      internal::TestFactoryBase* factory);
 
   // Constructs a TestInfo object. The newly constructed instance assumes
   // ownership of the factory object.
@@ -1107,6 +1114,8 @@ class GTEST_API_ UnitTest {
   // is called, a UnitTest object is constructed and returned.
   // Consecutive calls will return the same object.
   static UnitTest* GetInstance();
+  static UnitTest* Create() { return new UnitTest; }
+  static void Delete(UnitTest* u) { if (u) delete u; }
 
   // Runs all tests in this UnitTest object and prints the result.
   // Returns 0 if successful, or 1 otherwise.
@@ -1267,6 +1276,7 @@ class GTEST_API_ UnitTest {
   friend Environment* AddGlobalTestEnvironment(Environment* env);
   friend std::set<std::string>* internal::GetIgnoredParameterizedTestSuites();
   friend internal::UnitTestImpl* internal::GetUnitTestImpl();
+  friend internal::UnitTestImpl* internal::GetUnitTestImpl(UnitTest* u);
   friend void internal::ReportFailureInUnknownLocation(
       TestPartResult::Type result_type, const std::string& message);
 
diff --git a/googletest/include/gtest/internal/gtest-internal.h b/googletest/include/gtest/internal/gtest-internal.h
index e9c2441..5a7537c 100644
--- a/googletest/include/gtest/internal/gtest-internal.h
+++ b/googletest/include/gtest/internal/gtest-internal.h
@@ -583,6 +583,12 @@ GTEST_API_ TestInfo* MakeAndRegisterTestInfo(
     TypeId fixture_class_id, SetUpTestSuiteFunc set_up_tc,
     TearDownTestSuiteFunc tear_down_tc, TestFactoryBase* factory);
 
+GTEST_API_ TestInfo* UnitTestMakeAndRegisterTestInfo(UnitTest* u,
+    const char* test_suite_name, const char* name, const char* type_param,
+    const char* value_param, CodeLocation code_location,
+    TypeId fixture_class_id, SetUpTestSuiteFunc set_up_tc,
+    TearDownTestSuiteFunc tear_down_tc, TestFactoryBase* factory);
+
 // If *pstr starts with the given prefix, modifies *pstr to be right
 // past the prefix and returns true; otherwise leaves *pstr unchanged
 // and returns false.  None of pstr, *pstr, and prefix can be NULL.
diff --git a/googletest/src/gtest-internal-inl.h b/googletest/src/gtest-internal-inl.h
index 8c650e0..948b70d 100644
--- a/googletest/src/gtest-internal-inl.h
+++ b/googletest/src/gtest-internal-inl.h
@@ -961,6 +961,10 @@ inline UnitTestImpl* GetUnitTestImpl() {
   return UnitTest::GetInstance()->impl();
 }
 
+inline UnitTestImpl* GetUnitTestImpl(UnitTest* u) {
+  return u->impl();
+}
+
 #if GTEST_USES_SIMPLE_RE
 
 // Internal helper functions for implementing the simple regular
diff --git a/googletest/src/gtest.cc b/googletest/src/gtest.cc
index 3859452..7bf20b7 100644
--- a/googletest/src/gtest.cc
+++ b/googletest/src/gtest.cc
@@ -2769,6 +2769,19 @@ TestInfo* MakeAndRegisterTestInfo(
   return test_info;
 }
 
+
+TestInfo* UnitTestMakeAndRegisterTestInfo(
+    UnitTest* u, const char* test_suite_name, const char* name,
+    const char* type_param, const char* value_param, CodeLocation code_location,
+    TypeId fixture_class_id, SetUpTestSuiteFunc set_up_tc,
+    TearDownTestSuiteFunc tear_down_tc, TestFactoryBase* factory) {
+  TestInfo* const test_info =
+      new TestInfo(test_suite_name, name, type_param, value_param,
+                   code_location, fixture_class_id, factory);
+  GetUnitTestImpl(u)->AddTestInfo(set_up_tc, tear_down_tc, test_info);
+  return test_info;
+}
+
 void ReportInvalidTestSuiteType(const char* test_suite_name,
                                 CodeLocation code_location) {
   Message errors;
-- 
